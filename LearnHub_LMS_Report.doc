  <tr><td>user/reviews/create</td><td>/user/reviews/create/{course_id}</td><td>Review submission form (rating + comment)</td></tr>
  <tr><td>user/profile/edit</td><td>/profile</td><td>User profile: info, password, delete account</td></tr>
</table>

