  <tr><td>admin/courses/show</td><td>/admin/courses/{id}</td><td>Course detail: lessons, enrolled students, teachers</td></tr>
  <tr><td>admin/lessons/index</td><td>/admin/lessons/index</td><td>All lessons with course context</td></tr>
  <tr><td>admin/lessons/create</td><td>/admin/lessons/create</td><td>Create lesson with video upload</td></tr>
  <tr><td>admin/lessons/edit</td><td>/admin/lessons/edit/{id}</td><td>Edit lesson content</td></tr>
  <tr><td>admin/lessons/show</td><td>/admin/lessons/{id}</td><td>Lesson detail view</td></tr>
  <tr><td>admin/users/index</td><td>/admin/users/index</td><td>User list with role filter and search</td></tr>
  <tr><td>admin/users/show</td><td>/admin/users/{id}</td><td>User detail with enrollments</td></tr>
  <tr><td>admin/profile/edit</td><td>/admin/profile</td><td>Admin profile: info, password, delete account</td></tr>
  <tr><td>admin/notifications/index</td><td>/admin/notifications/index</td><td>Notification list with mark-read functionality</td></tr>
</table>

<h3>8.3 User Pages</h3>
<table>
  <tr><th>View</th><th>Route</th><th>Description</th></tr>
